# PostgreSQL LOCAL (fuente maestra)
LOCAL_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE_LOCAL

# PostgreSQL RAILWAY (copia para la API web)
# Si el worker corre fuera de Railway, usar la DATABASE_PUBLIC_URL.
RAILWAY_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE_RAILWAY
RAILWAY_DATABASE_SSL=true

# Tablas sincronizadas de la aplicacion administrativa
SYNC_TABLES=clientes,proveedores,cuentascobrar,cuentapagar,ventas,compras,comprasnv,trabajadores

# Cada cuantos milisegundos se revisan cambios
SYNC_INTERVAL_MS=10000

# Filas por lote de INSERT/UPDATE
SYNC_BATCH_SIZE=200
