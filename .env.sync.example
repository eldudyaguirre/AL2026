# PostgreSQL LOCAL (fuente maestra)
LOCAL_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE_LOCAL

# PostgreSQL RAILWAY (copia para la API web)
# Usar la DATABASE_PUBLIC_URL de Railway si el worker corre fuera de Railway.
RAILWAY_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE_RAILWAY
RAILWAY_DATABASE_SSL=true

# Tablas que se sincronizan
SYNC_TABLES=compras,comprasnv,proveedores

# Cada cuantos milisegundos se ejecuta la sincronizacion
SYNC_INTERVAL_MS=5000

# Filas por lote de INSERT
SYNC_BATCH_SIZE=200
